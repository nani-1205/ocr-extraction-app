# .env

# Google API Key (ensure this is the correct, valid key)
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY_HERE

# MongoDB Credentials
# NO extra quotes around values
# Comments MUST be on their own lines
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_HOST=localhost # Or host.docker.internal / 172.17.0.1 if running Mongo locally for Docker
MONGO_PORT=27017
MONGO_AUTH_DB=admin
MONGO_DB_NAME=ocr_results_db
MONGO_COLLECTION_NAME=extracted_data

# Flask Secret Key (change for production)
FLASK_SECRET_KEY=a_very_secret_key_for_dev_only

# API Authentication Key (CHANGE THIS to a strong, random secret)
API_SECRET_KEY=your_strong_random_api_secret_key_here

# Optional: Control Flask Debug Mode via environment (True for dev, False for prod)
FLASK_DEBUG=True

# Optional: Define upload folder path if different from default 'uploads'
# UPLOAD_FOLDER=./my_custom_uploads