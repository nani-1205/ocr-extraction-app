# .env
GOOGLE_API_KEY="YOUR_GOOGLE_AI_STUDIO_API_KEY"

MONGO_USER="your_mongo_user"
MONGO_PASSWORD="your_mongo_password"
MONGO_HOST="your_mongo_ip_or_hostname" # e.g., localhost or cluster URL
MONGO_PORT="27017" # Default MongoDB port
MONGO_AUTH_DB="admin" # The database to authenticate against (often 'admin')
MONGO_DB_NAME="ocr_results_db"
MONGO_COLLECTION_NAME="extracted_data"