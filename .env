# .env

# Google API Key (quotes are usually okay here, but can be removed if causing issues)
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY

# MongoDB Credentials
# NO quotes around values
# Comments MUST be on their own lines
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password
# MongoDB Host and Port
MONGO_HOST=your_mongo_ip_or_hostname
MONGO_PORT=27017
MONGO_AUTH_DB=admin
MONGO_DB_NAME=ocr_results_db
MONGO_COLLECTION_NAME=extracted_data

# Optional: Flask Secret Key for production
# FLASK_SECRET_KEY=your_very_strong_production_secret_key

# Optional: Control Flask Debug Mode via environment
# FLASK_DEBUG=False